rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny by default: every collection must be explicitly authorized below.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 135
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data, userId) {
      return isValidId(userId)
        && data.id is string
        && data.id == userId
        && data.id.size() <= 128;
    }

    function isValidWorkspace(data, workspaceId) {
      return isValidId(workspaceId)
        && data.id is string
        && data.id == workspaceId;
    }

    function isValidProject(data, projectId) {
      return isValidId(projectId)
        && data.id is string
        && data.id == projectId;
    }

    function isValidTask(data, taskId) {
      return isValidId(taskId)
        && data.id is string
        && data.id == taskId;
    }

    function isValidComment(data, commentId) {
      return isValidId(commentId)
        && data.id is string
        && data.id == commentId;
    }

    function isValidGolfCourse(data, courseId) {
      return isValidId(courseId)
        && data.id is string
        && data.id == courseId;
    }

    function isValidNotification(data, notificationId) {
      return isValidId(notificationId)
        && data.id is string
        && data.id == notificationId;
    }

    function isValidInfoNote(data, noteId) {
      return isValidId(noteId)
        && data.id is string
        && data.id == noteId;
    }

    function isValidLog(data) {
      return data.userId is string
        && data.userId.size() > 0
        && data.userId.size() <= 128
        && data.action is string
        && data.action.size() > 0;
    }

    // -----------------------------------------------------------------------
    // PHASE 1 SECURITY CONTAINMENT
    // -----------------------------------------------------------------------
    // The current app still uses Firebase Anonymous Auth behind its custom
    // email + access-code screen. Requiring request.auth here closes all
    // completely unauthenticated Firestore access without breaking the
    // current application flow.
    //
    // This is intentionally NOT the final authorization model. The next
    // security phase must replace the anonymous/custom-code login so rules
    // can enforce member/admin/workspace permissions server-side.
    // -----------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidUser(incoming(), userId);
      allow delete: if isSignedIn() && isValidId(userId);
    }

    match /workspaces/{workspaceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidWorkspace(incoming(), workspaceId);
      allow delete: if isSignedIn() && isValidId(workspaceId);
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidProject(incoming(), projectId);
      allow delete: if isSignedIn() && isValidId(projectId);
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidTask(incoming(), taskId);
      allow delete: if isSignedIn() && isValidId(taskId);
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidComment(incoming(), commentId);
      allow delete: if isSignedIn() && isValidId(commentId);
    }

    match /golfCourses/{courseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidGolfCourse(incoming(), courseId);
      allow delete: if isSignedIn() && isValidId(courseId);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidNotification(incoming(), notificationId);
      allow delete: if isSignedIn() && isValidId(notificationId);
    }

    match /infoNotes/{noteId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidInfoNote(incoming(), noteId);
      allow delete: if isSignedIn() && isValidId(noteId);
    }

    match /meetingMinutes/{minuteId} {
      allow read, write: if isSignedIn() && isValidId(minuteId);
    }

    match /reputationSnapshots/{snapshotId} {
      allow read, write: if isSignedIn() && isValidId(snapshotId);
    }

    match /leadingCoursesSnapshots/{snapshotId} {
      allow read, write: if isSignedIn() && isValidId(snapshotId);
    }

    match /deletedItems/{itemId} {
      allow read, write: if isSignedIn() && isValidId(itemId);
    }

    // Audit logs remain append-only: authenticated clients can add entries,
    // but no client can edit or erase the audit trail.
    match /logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidLog(incoming());
      allow update, delete: if false;
    }

    match /presence/{userId} {
      allow read, write: if isSignedIn() && isValidId(userId);
    }
  }
}
